<?xml version="1.0" encoding="utf-8"?>
<templates>
    <t t-name="dsl_custom_demo.partner_card" t-att-role="'region'" t-att-aria-label="'Partner Card'">
        <group>
            <t t-esc="props.display_name"/>
            <t t-esc="props.email"/>
            <t t-if="state === 'active'">
                <label string="Active"/>
            </t>
        </group>
        <t t-foreach="records" t-as="rec">
            <t t-esc="props.rec.name"/>
        </t>
    </t>
</templates>